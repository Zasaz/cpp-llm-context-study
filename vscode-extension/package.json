{
	"name": "cpp-helper-bot",
	"displayName": "C++ Helper Bot",
	"publisher": "umair-ahmed",
	"description": "Analyzes C++ projects using the C++ Helper API",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onView:cpp-helper-sidebar-view",
		"onCommand:cpp-helper-bot.start"
	],
	"contributes": {
		"commands": [
			{
				"command": "cpp-helper-bot.start",
				"title": "Start C++ Helper Bot"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cpp-helper-sidebar",
					"title": "C++ Helper",
					"icon": "icons/icon.svg"
				}
			]
		},
		"views": {
			"cpp-helper-sidebar": [
				{
					"id": "cpp-helper-sidebar-view",
					"name": "C++ Helper",
					"type": "webview",
					"contextualTitle": "C++ Helper Bot",
					"retainContextWhenHidden": true
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@typescript-eslint/eslint-plugin": "^8.45.0",
		"@typescript-eslint/parser": "^8.45.0",
		"eslint": "^9.36.0",
		"esbuild": "^0.25.10",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2"
	},
	"dependencies": {
		"axios": "^1.6.2"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"fsevents@2.3.3": true
	}
}
